# Copy to .env.local and enter values from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix this key with NEXT_PUBLIC_. Required to invite staff.
SUPABASE_SECRET_KEY=
# Must match the approved Supabase Site URL; use your HTTPS domain in production.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# With no Supabase URL/key, development shows a read-only preview.
# Production always requires a configured backend and a real staff account.
